<div class="h-screen flex items-start justify-center px-4 sm:px-6 lg:px-8 pt-20 pb-4">
  <div class="max-w-5xl w-full mt-16">
    <!-- Compact Header -->
    <div class="text-center mb-6 slide-in-top">
      <p class="text-sm text-gray-500 mb-1 tracking-wide">Backed by legendary investor frameworks</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">
        Investment Moguls as Your Analysts
      </h1>
    </div>

    <%= form_with url: analyses_path, method: :post, class: "fade-in", data: { controller: "analysis-form", action: "submit->analysis-form#submit" } do |form| %>
      <div class="bg-white rounded-lg shadow-lg p-6 sm:p-8">
        <!-- Top Row: Investor & Ticker side-by-side on tablets+ -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <!-- Investor Dropdown -->
          <div data-controller="investor-dropdown" class="relative">
            <label class="block text-sm font-semibold text-gray-900 mb-2">
              Choose Your Advisor
            </label>

            <!-- Hidden input for form submission -->
            <%= hidden_field_tag :investor_id, "", data: { investor_dropdown_target: "input" }, required: true %>

            <!-- Custom Dropdown Button -->
            <button type="button"
                    data-action="click->investor-dropdown#toggle"
                    class="w-full bg-white border-2 border-gray-300 rounded-lg px-4 py-3 text-left hover:border-indigo-400 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 hover:shadow-md">
              <div data-investor-dropdown-target="selected" class="text-gray-500">
                <div class="flex items-center justify-between">
                  <span>Select an advisor...</span>
                  <svg class="w-5 h-5 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </div>
              </div>
            </button>

            <!-- Dropdown Menu -->
            <div data-investor-dropdown-target="menu"
                 class="hidden absolute z-50 mt-2 left-0 right-0 bg-white border border-gray-200 rounded-lg shadow-xl overflow-hidden">
              <div class="max-h-80 overflow-y-auto">
                <% @investors.each do |investor| %>
                  <div data-investor-dropdown-target="option"
                       data-action="click->investor-dropdown#select"
                       data-investor-id="<%= investor.id %>"
                       data-investor-name="<%= investor.name %>"
                       data-investor-initials="<%= investor.name.split.map(&:first).join %>"
                       data-investor-persona="<%= case investor.persona
                         when 'munger' then 'Kill Switches & Mental Models'
                         when 'buffett' then 'Economic Moat & DCF Analysis'
                         when 'lynch' then 'GARP - Growth at Reasonable Price'
                         when 'graham' then 'Quantitative Value Investing'
                         when 'dalio' then 'Economic Machine & Risk Parity'
                         end %>"
                       class="flex items-center space-x-2 p-3 hover:bg-indigo-50 cursor-pointer transition-all border-l-4 border-gray-200 relative">
                    <div class="w-6 h-6 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-[10px] flex-shrink-0">
                      <%= investor.name.split.map(&:first).join %>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-semibold text-gray-900 text-sm"><%= investor.name %></div>
                    </div>
                    <svg class="checkmark hidden w-6 h-6 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Stock Ticker Input -->
          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">
              Stock Ticker
            </label>
            <%= text_field_tag :ticker, params[:ticker],
                placeholder: "e.g., AAPL, MSFT, GOOGL",
                class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 uppercase transition-all",
                data: { analysis_form_target: "ticker", action: "blur->analysis-form#validateTicker input->analysis-form#validateTicker" },
                required: true %>
            <p class="text-red-600 text-sm mt-2 hidden" data-analysis-form-target="tickerError"></p>
          </div>
        </div>

        <!-- Bottom Row: Question field full width -->
        <div>
          <label class="block text-sm font-semibold text-gray-900 mb-2">
            Your Question
          </label>
          <%= text_area_tag :question, params[:question],
              placeholder: "e.g., Should I invest in this company? What are the risks? How does it compare to competitors?",
              rows: 4,
              class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all resize-none",
              data: { analysis_form_target: "question", action: "blur->analysis-form#validateQuestion" },
              required: true %>
          <p class="text-red-600 text-sm mt-2 hidden" data-analysis-form-target="questionError"></p>
        </div>

        <!-- Submit Button -->
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <% if current_user %>
            <div class="text-sm text-gray-600">
              <span class="font-medium"><%= current_user.analyses.where("created_at > ?", 24.hours.ago).count %></span>
              of
              <span class="font-medium"><%= current_user.daily_analysis_limit == Float::INFINITY ? "unlimited" : current_user.daily_analysis_limit %></span>
              analyses used today
            </div>
          <% else %>
            <div></div>
          <% end %>

          <%= button_tag type: "submit",
              data: { analysis_form_target: "submit" },
              class: "w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2.5 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed transform hover:scale-105 active:scale-95" do %>
            <span data-analysis-form-target="submitText" class="flex items-center justify-center">
              <svg class="inline w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
              Get Analysis
            </span>
            <span data-analysis-form-target="spinner" class="hidden flex items-center justify-center">
              <svg class="animate-spin h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Analyzing...
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
