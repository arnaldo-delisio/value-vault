<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Header -->
  <div class="mb-6 sm:mb-8 slide-in-top">
    <%= link_to analyses_path, class: "text-indigo-600 hover:text-indigo-700 text-sm font-medium mb-4 inline-flex items-center transition-all duration-200 hover:translate-x-1" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Analyses
    <% end %>

    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mt-4 mb-2">
      <%= @analysis.stock.ticker %> Analysis
    </h1>
    <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs sm:text-sm text-gray-600">
      <span class="flex items-center">
        <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-xs mr-2">
          <%= @analysis.investor.name.split.map(&:first).join %>
        </div>
        <%= @analysis.investor.name %>
      </span>
      <span>•</span>
      <span><%= @analysis.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
      <span>•</span>
      <span class="<%= @analysis.completed? ? 'text-green-600' : @analysis.failed? ? 'text-red-600' : 'text-yellow-600' %>">
        <%= @analysis.status.titleize %>
      </span>
    </div>
  </div>

  <!-- Question Card -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-6 fade-in hover-lift transition-smooth">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Question</h2>
    <p class="text-lg text-gray-900"><%= @analysis.question %></p>
  </div>

  <!-- Analysis Result -->
  <% if @analysis.completed? %>
    <div class="bg-white rounded-lg shadow-md p-8 fade-in" data-controller="markdown share">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
        <h2 class="text-2xl font-bold text-gray-900">Analysis Results</h2>
        <div class="flex items-center space-x-3">
          <button data-action="click->share#copyLink"
                  data-share-target="button"
                  class="bg-gray-600 hover:bg-gray-700 text-white px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all flex items-center space-x-1 sm:space-x-2">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-share-target="icon">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            </svg>
            <span class="hidden sm:inline">Share Link</span>
            <span class="sm:hidden">Share</span>
          </button>
          <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs sm:text-sm font-medium">
            Completed
          </span>
        </div>
      </div>

      <!-- Table of Contents (shown for long analyses) -->
      <div data-markdown-target="toc" class="bg-indigo-50 border border-indigo-200 rounded-lg p-4 mb-6">
        <h3 class="text-sm font-semibold text-indigo-900 mb-3 flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
          </svg>
          Table of Contents
        </h3>
        <!-- TOC will be inserted here by JavaScript -->
      </div>

      <div class="prose prose-lg prose-indigo max-w-none markdown-content" data-markdown-target="content">
        <%= @analysis.response %>
      </div>
    </div>
  <% elsif @analysis.processing? %>
    <div class="bg-white rounded-lg shadow-md p-12">
      <div class="text-center mb-8">
        <div class="inline-block animate-spin rounded-full h-16 w-16 border-t-2 border-b-2 border-indigo-600 mb-4"></div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Analyzing <%= @analysis.stock.ticker %>...</h3>
        <p class="text-gray-600">
          <%= @analysis.investor.name %> is working on your analysis
        </p>
      </div>

      <!-- Progress Steps -->
      <div class="max-w-2xl mx-auto space-y-4">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-600">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-900">Fetching stock data</p>
            <p class="text-sm text-gray-500">Retrieved latest financial metrics and historical data</p>
          </div>
        </div>

        <div class="flex items-start animate-pulse">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 text-indigo-600">
              <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-900">Analyzing with <%= @analysis.investor.name %>'s framework</p>
            <p class="text-sm text-gray-500">Applying investment principles and evaluating metrics (this may take 30-60 seconds)</p>
          </div>
        </div>

        <div class="flex items-start opacity-50">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-900">Preparing results</p>
            <p class="text-sm text-gray-500">Formatting analysis and recommendations</p>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center">
        <p class="text-sm text-gray-500">Page will automatically refresh when complete</p>
      </div>
    </div>

    <!-- Auto-refresh script -->
    <script>
      setTimeout(function() {
        location.reload();
      }, 5000); // Refresh every 5 seconds
    </script>
  <% elsif @analysis.failed? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <div class="flex items-start">
        <svg class="w-6 h-6 text-red-600 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div>
          <h3 class="text-lg font-semibold text-red-900 mb-2">Analysis Failed</h3>
          <p class="text-red-800"><%= @analysis.error_message %></p>
          <div class="mt-4">
            <%= link_to "Try Again", new_analysis_path(ticker: @analysis.stock.ticker, investor_id: @analysis.investor.id, question: @analysis.question),
                class: "text-red-600 hover:text-red-700 font-medium" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
